@startuml POST_predict
skinparam sequenceMessageAlign center
actor User
participant API
participant Processor
participant FeatureStore
participant "Активная LightGBM" as Model

User -> API : POST /predict {"items":[{"shop_id":1,"item_id":2}]}
alt Предиктор ещё не загружен
    API --> User : 503
else Ошибка валидации
    API --> User : 422
else Запрос принят
    API -> Processor : Пары в исходном порядке
    Processor -> FeatureStore : Строит 31 признак по истории до target_month
    alt Есть неизвестный ID
        FeatureStore --> Processor : UnknownIdError
        Processor --> API : Неизвестные магазины и товары
        API --> User : 400 {detail}
    else Все ID известны
        FeatureStore --> Processor : Признаки с NaN для пропусков истории
        Processor -> Model : Батч признаков
        Model --> Processor : Сырые прогнозы
        Processor -> Processor : clip [0, 20]
        Processor --> API : Прогнозы в исходном порядке
        alt Число прогнозов совпадает с числом пар
            API --> User : 200 {predictions}
        else Предиктор вернул неверное число прогнозов
            API --> User : 500
        end
    end
end
@enduml
