@startuml deployment
top to bottom direction
' skinparam linetype polyline

actor User
rectangle DockerContainer {
    component API
    component ModelRegistry {
        artifact lgbm
    }
    component Processor
    storage FeatureStore
    component WorkFlowPipeline
}

User --> API : Запрашивает прогноз
API --> Processor : Передает запрос
Processor --> FeatureStore : Запрашивает признаки
Processor --> ModelRegistry : Требует прогноз по данным c признаками
Processor --> WorkFlowPipeline : Запускает пайплайн данных/модели
WorkFlowPipeline --> FeatureStore : Выгружает Gold данные
WorkFlowPipeline --> ModelRegistry : Выгружает модель и метаданные


@enduml