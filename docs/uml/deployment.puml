@startuml deployment
top to bottom direction
' skinparam linetype polyline

actor User
rectangle DockerContainer {
    component API
    component "ModelRegistry\nMLflow" as ModelRegistry {
        artifact lgbm
    }
    component Processor
    component FeatureStore
    component WorkFlowPipeline
}

storage "Исходные CSV" as Dataset
storage "SQLite и артефакты" as Volume

User --> API : Запрашивает прогноз или обучение
API --> Processor : Передаёт запросы прогноза, \n обучения и статуса
Processor --> WorkFlowPipeline : Передаёт TrainingData\nдля обучения
Processor --> ModelRegistry : Ведёт запуски,\nрегистрирует и активирует версии
Processor --> FeatureStore : Получает признаки для обучения\nи прогноза
Processor --> Dataset : Читает исходные CSV для снимка
ModelRegistry --> Volume : Версии, запуски и снимки

@enduml
